package-as: SszorakHelper

move-folders:
  SszorakHelper/Options: SszorakHelper_Options

enable-nolib-creation: no
manual-changelog: CHANGELOG.md
changelog-format: markdown

ignore:
  - .agents
  - .codex
  - .github
  - .gitignore
  - .pkgmeta
  - AGENTS.md
  - CHANGELOG.md
  - README.md
  - build.ps1
  - deploy.ps1
  - update_and_push.ps1
  - verify.ps1
